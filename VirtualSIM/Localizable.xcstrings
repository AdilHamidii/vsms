    "Numbers and email addresses you buy show up here, with the code and with the refund if one never arrived.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekaufte Nummern und E-Mail-Adressen erscheinen hier – mit dem Code und mit der Erstattung, falls keiner ankam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números y las direcciones de correo que compres aparecen aquí, con el código y con el reembolso si nunca llegó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numéros et adresses e-mail que vous achetez s'affichent ici, avec le code et avec le remboursement si aucun n'est arrivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri e gli indirizzi email che acquisti compaiono qui, con il codice e con il rimborso se non è mai arrivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入した番号やメールアドレスはここに表示されます。受信したコードや、届かなかった場合の返金も確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números e endereços de e-mail que você compra aparecem aqui, com o código e com o reembolso, se nenhum chegou."
          }
        }
      }
    },
    "Numbers are bought with credits. If no code turns up, your credits go straight back to your balance — every time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummern werden mit Credits gekauft. Kommt kein Code an, gehen deine Credits sofort zurück auf dein Guthaben – jedes Mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Numbers are bought with credits. If no code turns up, your credits go straight back to your balance, every time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números se compran con créditos. Si no llega ningún código, tus créditos vuelven al instante a tu saldo, siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numéros s'achètent avec des crédits. Si aucun code n'arrive, vos crédits reviennent aussitôt sur votre solde, à chaque fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri si acquistano con i crediti. Se non arriva nessun codice, i crediti tornano subito sul tuo saldo, ogni volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号はクレジットで購入します。コードが届かなかった場合は、クレジットがすぐに残高へ戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números são comprados com créditos. Se nenhum código chegar, seus créditos voltam na hora para o seu saldo, sempre."
          }
        }
      }
    },
