    "Share your code. A friend who joins with it gets **2 free credits** — and you get **5 credits** when they buy their first pack.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie Ihren Code. Wer damit beitritt, erhält **2 Gratis-Credits** – und Sie bekommen **5 Credits**, sobald die Person ihr erstes Paket kauft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu código. Quien se una con él recibe **2 créditos gratis**, y tú recibes **5 créditos** cuando compre su primer pack."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre code. Un ami qui s'inscrit avec reçoit **2 crédits offerts**, et vous recevez **5 crédits** à son premier achat de pack."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il tuo codice. Chi si iscrive con esso riceve **2 crediti gratis**, e tu ricevi **5 crediti** al suo primo acquisto di un pacchetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを共有しましょう。コードで登録した友達は**無料クレジット2**を獲得。友達が最初のパックを購入すると、あなたに**クレジット5**が入ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seu código. Quem entrar com ele ganha **2 créditos grátis**, e você ganha **5 créditos** quando a pessoa comprar o primeiro pacote."
          }
        }
      }
    },
    "Share your code. A friend who joins with it starts with **%lld free credits**, and you get **5 credits** when they buy their first pack.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deinen Code. Wer damit beitritt, startet mit **%lld Gratis-Credits** – und du bekommst **5 Credits**, sobald sie ihr erstes Paket kaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu código. Quien se una con él empieza con **%lld créditos gratis**, y tú recibes **5 créditos** cuando compre su primer paquete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre code. Celui qui s'inscrit avec démarre avec **%lld crédits offerts**, et vous recevez **5 crédits** dès son premier achat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il tuo codice. Chi si iscrive con quel codice inizia con **%lld crediti gratis**, e tu ricevi **5 crediti** al suo primo acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを共有しましょう。そのコードで参加した友だちは**%lldクレジット無料**で始められ、最初のパック購入時にあなたに**5クレジット**が入ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seu código. Quem entrar com ele começa com **%lld créditos grátis**, e você ganha **5 créditos** na primeira compra dessa pessoa."
          }
        }
      }
    },
