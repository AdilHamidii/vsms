    "We ask the mail provider for live stock every time, so this needs a connection. Nothing has been charged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir fragen den Mail-Anbieter jedes Mal live nach dem Bestand, dafür ist eine Verbindung nötig. Es wurde nichts berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultamos el stock en vivo al proveedor de correo cada vez, así que esto necesita conexión. No se ha cobrado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous demandons le stock en direct au fournisseur à chaque fois, une connexion est donc nécessaire. Rien n'a été facturé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiediamo ogni volta la disponibilità in tempo reale al fornitore di posta, quindi serve una connessione. Non è stato addebitato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回メールプロバイダに在庫を問い合わせるため、通信環境が必要です。料金は発生していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultamos o provedor de e-mail sobre o estoque em tempo real a cada vez, então isso precisa de conexão. Nada foi cobrado."
          }
        }
      }
    },
    "We couldn't delete your account. Please try again.": {
