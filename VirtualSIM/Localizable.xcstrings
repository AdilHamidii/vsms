    },
    "We're sorry for the hassle. We're actively working on improving delivery rates.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir bitten um Entschuldigung für die Unannehmlichkeiten. Wir arbeiten aktiv daran, die Zustellraten zu verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentimos las molestias. Estamos trabajando activamente para mejorar las tasas de entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolés pour la gêne occasionnée. Nous travaillons activement à améliorer les taux de réception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci scusiamo per il disagio. Stiamo lavorando attivamente per migliorare i tassi di consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご不便をおかけして申し訳ありません。到達率の改善に取り組んでいます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedimos desculpas pelo transtorno. Estamos trabalhando ativamente para melhorar as taxas de entrega."
          }
        }
      }
    },
    "We're updating live prices. Ordering is paused for a few minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir aktualisieren gerade die Live-Preise. Bestellungen sind für einige Minuten pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos actualizando los precios en vivo. Los pedidos están en pausa unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous mettons à jour les prix en direct. Les commandes sont suspendues quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo aggiornando i prezzi live. Gli ordini sono in pausa per qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新価格を更新中です。注文は数分間停止しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos atualizando os preços. Os pedidos estão pausados por alguns minutos."
          }
        }
      }
    },
    "We've paused data plans while we make some improvements. Any eSIM you already bought keeps working. Find it under My eSIMs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Datentarife pausiert, während wir einige Verbesserungen vornehmen. Bereits gekaufte eSIMs funktionieren weiterhin – du findest sie unter „Meine eSIMs“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos pausado los planes de datos mientras hacemos algunas mejoras. Cualquier eSIM que ya hayas comprado sigue funcionando: la encontrarás en Mis eSIM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons suspendu les forfaits data le temps d’apporter quelques améliorations. Toute eSIM déjà achetée continue de fonctionner. Retrouvez-la dans « Mes eSIM »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo messo in pausa i piani dati mentre apportiamo alcuni miglioramenti. Le eSIM già acquistate continuano a funzionare: le trovi in Le mie eSIM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改善作業のため、データプランを一時停止しています。購入済みのeSIMは引き続きご利用いただけます（「マイeSIM」からご確認ください）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausamos os planos de dados enquanto fazemos algumas melhorias. Qualquer eSIM que você já comprou continua funcionando. Encontre em Meus eSIMs."
          }
        }
      }
    },
    "We've paused new numbers while we make some improvements. Check back soon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben neue Nummern pausiert, während wir einige Verbesserungen vornehmen. Schauen Sie bald wieder vorbei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos pausado los números nuevos mientras hacemos algunas mejoras. Vuelve pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons suspendu les nouveaux numéros le temps d'apporter quelques améliorations. Revenez bientôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
