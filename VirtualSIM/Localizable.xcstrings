    "That email domain just ran out. Try another one.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Domain ist gerade ausverkauft. Versuchen Sie eine andere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese dominio de correo se acaba de agotar. Pruebe con otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce domaine e-mail vient d'être épuisé. Essayez-en un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel dominio email si è appena esaurito. Ne provi un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのメールドメインは在庫切れになりました。別のものをお試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse domínio de e-mail acabou. Tente outro."
          }
        }
      }
    },
    "That purchase didn't complete. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf wurde nicht abgeschlossen. Bitte erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa compra no se completó. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat n'a pas abouti. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto non è andato a buon fine. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は完了しませんでした。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra não foi concluída. Tente novamente."
          }
        }
      }
    },
    "That service isn't available anymore.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Dienst ist nicht mehr verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese servicio ya no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce service n'est plus disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel servizio non è più disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのサービスは利用できなくなりました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse serviço não está mais disponível."
          }
        }
      }
    },
    "That's the whole idea. You're here to keep your real number to yourself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau darum geht es – Sie sind hier, um Ihre echte Nummer für sich zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es la idea: estás aquí para no compartir tu número real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est tout l'intérêt. Vous êtes ici pour garder votre vrai numéro pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È proprio questo il punto: sei qui per tenere il tuo numero vero per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それこそがこのアプリの目的です。本当の番号は自分だけのものに。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa é a ideia. Você está aqui para manter seu número real só seu."
          }
        }
      }
    },
    "The App Store isn't offering this subscription right now. Please try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store bietet dieses Abo gerade nicht an. Bitte versuchen Sie es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store no ofrece esta suscripción ahora mismo. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store ne propose pas cet abonnement pour le moment. Veuillez réessayer dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store non offre questo abbonamento al momento. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在App Storeでこのサブスクリプションを提供できません。少ししてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não está oferecendo esta assinatura agora. Tente novamente em instantes."
          }
        }
      }
    },
    "The catalog hasn't loaded yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Katalog ist noch nicht geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El catálogo aún no se ha cargado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le catalogue n'est pas encore chargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
