    "Get a private temporary number for verification codes on vSMS — join with my code %@ and start with %lld free credits: https://apps.apple.com/app/id6774768570": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Get a private temporary number for verification codes on vSMS — join with my code %1$@ and start with %2$lld free credits: https://apps.apple.com/app/id6774768570"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir eine private temporäre Nummer für Bestätigungscodes bei vSMS – tritt mit meinem Code %@ bei und starte mit %lld Gratis-Credits: https://apps.apple.com/app/id6774768570"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue un número temporal privado para códigos de verificación en vSMS: únete con mi código %@ y empieza con %lld créditos gratis: https://apps.apple.com/app/id6774768570"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez un numéro temporaire privé pour vos codes de vérification sur vSMS — inscrivez-vous avec mon code %@ et démarrez avec %lld crédits offerts : https://apps.apple.com/app/id6774768570"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni un numero temporaneo privato per i codici di verifica su vSMS — iscriviti con il mio codice %@ e inizia con %lld crediti gratis: https://apps.apple.com/app/id6774768570"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "vSMSで認証コード用のプライベートな一時番号を取得しましょう。私のコード%@で参加すると%lldクレジット無料で始められます: https://apps.apple.com/app/id6774768570"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha um número temporário privado para códigos de verificação no vSMS — entre com meu código %@ e comece com %lld créditos grátis: https://apps.apple.com/app/id6774768570"
          }
        }
      }
    },
    "Get a private temporary number for verification codes on vSMS — my invite code %@ gives you 2 free credits: https://apps.apple.com/app/id6774768570": {
      "extractionState": "stale",
      "localizations": {
        "de": {
