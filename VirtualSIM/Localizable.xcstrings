    "We hold your credits for 8 minutes while the code comes through.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir halten Ihre Credits 8 Minuten zurück, während der Code ankommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
