    "Costs another %lld cr. This number keeps running and still refunds itself if no code arrives.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostet weitere %lld Cr. Diese Nummer läuft weiter und wird weiterhin erstattet, wenn kein Code ankommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuesta %lld cr más. Este número sigue activo y se reembolsa igualmente si no llega ningún código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coûte %lld cr de plus. Ce numéro reste actif et sera quand même remboursé si aucun code n’arrive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costa altri %lld cr. Questo numero resta attivo e viene comunque rimborsato se non arriva alcun codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加で %lld クレジットかかります。この番号は有効なままで、コードが届かなければ返金されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Custa mais %lld cr. Este número continua ativo e ainda é reembolsado se nenhum código chegar."
          }
        }
      }
    },
