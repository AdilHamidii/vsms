      }
    },
    "This eSIM can only be installed once. If it's already on your device, check Settings → Cellular instead. Installing again will fail.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese eSIM lässt sich nur einmal installieren. Wenn sie schon auf deinem Gerät ist, schau unter Einstellungen → Mobilfunk – eine erneute Installation schlägt fehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta eSIM solo puede instalarse una vez. Si ya está en tu dispositivo, revisa Ajustes → Datos móviles: volver a instalarla fallará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette eSIM ne peut être installée qu'une seule fois. Si elle est déjà sur votre appareil, allez dans Réglages → Données cellulaires. Une nouvelle installation échouera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa eSIM può essere installata una sola volta. Se è già sul tuo dispositivo, controlla Impostazioni → Cellulare: una nuova installazione non riuscirà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このeSIMは一度しかインストールできません。すでに端末にある場合は「設定」→「モバイル通信」をご確認ください。再インストールは失敗します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este eSIM só pode ser instalado uma vez. Se já estiver no seu aparelho, veja em Ajustes → Celular. Instalar de novo vai falhar."
          }
        }
      }
    },
    "This eSIM couldn't be provisioned, so your credits went straight back to your balance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese eSIM konnte nicht bereitgestellt werden – deine Credits sind direkt zurück auf dein Guthaben geflossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aprovisionar esta eSIM, así que tus créditos volvieron directamente a tu saldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette eSIM n'a pas pu être provisionnée : vos crédits sont revenus directement sur votre solde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile attivare questa eSIM, quindi i tuoi crediti sono tornati subito sul saldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このeSIMを発行できなかったため、クレジットは残高にそのまま戻りました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível provisionar este eSIM, então seus créditos voltaram direto para o saldo."
          }
        }
      }
    },
    "This number can't call 911 or any emergency service. Always use your phone's own number for emergencies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser Nummer erreichen Sie den Notruf 911 und andere Notdienste nicht. Nutzen Sie im Notfall immer die eigene Nummer Ihres Telefons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número no puede llamar al 911 ni a ningún servicio de emergencia. Usa siempre el número propio de tu teléfono para emergencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce numéro ne permet pas d'appeler le 911 ni aucun service d'urgence. Utilisez toujours le numéro de votre téléphone en cas d'urgence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo numero non può chiamare il 911 né alcun servizio di emergenza. Per le emergenze usa sempre il numero del tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この番号では911などの緊急通報はできません。緊急時は必ずご自身の電話番号をご利用ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número não liga para o 911 nem para nenhum serviço de emergência. Use sempre o número do seu próprio telefone em emergências."
          }
        }
      }
    },
