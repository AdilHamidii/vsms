    "We couldn't get an address right now. Please try again.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten gerade keine Adresse abrufen. Bitte erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos obtener una dirección ahora. Inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu obtenir d'adresse. Veuillez réessayer."
          }
        },
        "it": {
