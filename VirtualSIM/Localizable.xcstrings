          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カタログがまだ読み込まれていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O catálogo ainda não carregou."
          }
        }
      }
    },
    "The code lands here. Paste it back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code landet hier – fügen Sie ihn dort ein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código aparece aquí: pégalo de vuelta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code arrive ici. Collez-le ensuite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice arriva qui. Incollalo di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードはここに表示されます。貼り付けて戻しましょう"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código aparece aqui. É só colar de volta"
          }
        }
      }
    },
    "The window closed before anything arrived, so your %lld credits went back to your balance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zeitfenster schloss, bevor etwas ankam – Ihre %lld Credits sind zurück auf Ihrem Guthaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana se cerró antes de que llegara nada, así que tus %lld créditos volvieron a tu saldo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre s'est fermée avant que quoi que ce soit n'arrive : vos %lld crédits sont revenus sur votre solde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra si è chiusa prima che arrivasse qualcosa, quindi i tuoi %lld crediti sono tornati sul saldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も届かないまま受付時間が終了したため、%lldクレジットは残高に戻りました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela fechou antes de qualquer coisa chegar, então seus %lld créditos voltaram para o saldo."
          }
        }
      }
    },
    "The window closed before anything arrived. Nothing was charged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zeitfenster schloss, bevor etwas ankam. Es wurde nichts berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana se cerró antes de que llegara nada. No se ha cobrado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre s'est fermée avant que quoi que ce soit n'arrive. Rien n'a été facturé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra si è chiusa prima che arrivasse qualcosa. Non è stato addebitato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も届かないまま受付時間が終了しました。料金は発生していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela fechou antes de qualquer coisa chegar. Nada foi cobrado."
          }
        }
      }
    },
    "There's a problem with your payment. Update it to keep your number. Everything still works for now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt ein Problem mit Ihrer Zahlung. Aktualisieren Sie sie, um Ihre Nummer zu behalten – vorerst funktioniert noch alles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un problema con tu pago. Actualízalo para conservar tu número; por ahora todo sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu avec votre paiement. Mettez-le à jour pour conserver votre numéro. Tout fonctionne encore pour l'instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è un problema con il tuo pagamento. Aggiornalo per mantenere il tuo numero. Per ora funziona ancora tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いに問題があります。番号を維持するにはお支払い方法を更新してください。今のところ機能はすべて利用できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um problema com seu pagamento. Atualize para manter seu número. Por enquanto tudo continua funcionando."
          }
        }
      }
    },
    "This address never got a code": {
      "localizations": {
