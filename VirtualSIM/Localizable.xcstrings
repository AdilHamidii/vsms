    "Real SIM costs %lld credits and has the best delivery rate": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Echte SIM kostet %lld Credits und hat die beste Zustellrate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La SIM real cuesta %lld créditos y tiene la mejor tasa de entrega"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La SIM réelle coûte %lld crédits et offre le meilleur taux de réception"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La SIM reale costa %lld crediti e ha il miglior tasso di consegna"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実SIMは%lldクレジットで、最高の受信率です"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SIM real custa %lld créditos e tem a melhor taxa de entrega"
          }
        }
      }
    },
    "Real SIM costs %lld credits instead of %lld. It uses a named mobile carrier instead of any available number, and refunds instead of substituting one if that carrier is unavailable.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Echte SIM kostet %lld statt %lld Credits. Sie nutzt einen benannten Mobilfunkanbieter statt irgendeiner freien Nummer und erstattet, statt zu ersetzen, wenn dieser Anbieter nicht verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Real SIM costs %1$lld credits instead of %2$lld. It uses a named mobile carrier instead of any available number, and refunds instead of substituting one if that carrier is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La SIM real cuesta %lld créditos en vez de %lld. Usa un operador móvil concreto en lugar de cualquier número disponible, y reembolsa en vez de sustituirlo si ese operador no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La SIM réelle coûte %lld crédits au lieu de %lld. Elle utilise un opérateur mobile nommé plutôt qu'un numéro quelconque, et rembourse au lieu de le remplacer si cet opérateur est indisponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La SIM reale costa %lld crediti invece di %lld. Usa un operatore mobile specifico anziché un numero qualsiasi e rimborsa invece di sostituirlo se quell'operatore non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルSIMは%lldクレジットではなく%lldクレジットです。空いている番号ではなく指定の通信事業者を使い、その事業者が利用できない場合は代替せず返金します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SIM real custa %lld créditos em vez de %lld. Usa uma operadora específica em vez de qualquer número disponível e reembolsa em vez de substituir se essa operadora não estiver disponível."
          }
        }
      }
    },
