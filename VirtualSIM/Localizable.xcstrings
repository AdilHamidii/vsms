        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha um número temporário privado para códigos de verificação no vSMS. Entre com meu código %@ e comece com %lld créditos grátis: https://apps.apple.com/app/id6774768570"
