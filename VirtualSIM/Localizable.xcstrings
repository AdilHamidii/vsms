    "Your %lld credits are safe. Every order that ends without a code is refunded in full. The outcome will show in Orders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre %lld Credits sind sicher – jede Bestellung, die ohne Code endet, wird voll erstattet. Das Ergebnis erscheint unter „Bestellungen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus %lld créditos están a salvo: todo pedido que termina sin código se reembolsa por completo. El resultado aparecerá en Pedidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos %lld crédits sont en sécurité. Toute commande qui se termine sans code est intégralement remboursée. Le résultat s'affichera dans Commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi %lld crediti sono al sicuro. Ogni ordine che finisce senza codice viene rimborsato per intero. L'esito comparirà in Ordini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldクレジットは安全です。コードが届かずに終了した注文はすべて全額返金されます。結果は「注文」に表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus %lld créditos estão seguros. Todo pedido que termina sem código é reembolsado integralmente. O resultado vai aparecer em Pedidos."
          }
        }
      }
    },
    "Your %lld credits go back to your balance. If a code is already on its way, you'll lose it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
