          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen Sie Ihren Code. Wer damit beitritt, erhält **2 Gratis-Credits** – und Sie bekommen **5 Credits**, sobald die Person ihr erstes Paket kauft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu código. Quien se una con él recibe **2 créditos gratis**, y tú recibes **5 créditos** cuando compre su primer pack."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez votre code. Un ami qui s'inscrit avec reçoit **2 crédits offerts** — et vous recevez **5 crédits** à son premier achat de pack."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi il tuo codice. Chi si iscrive con esso riceve **2 crediti gratis** — e tu ricevi **5 crediti** al suo primo acquisto di un pacchetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードを共有しましょう。コードで登録した友達は**無料クレジット2**を獲得。友達が最初のパックを購入すると、あなたに**クレジット5**が入ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe seu código. Quem entrar com ele ganha **2 créditos grátis** — e você ganha **5 créditos** quando a pessoa comprar o primeiro pacote."
          }
        }
      }
    },
    "Show success metrics" : {
      "extractionState" : "manual",
