    "Any domain works the same. The free ones run out most often, so stock is checked live.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Domain funktioniert gleich. Die kostenlosen sind am schnellsten vergriffen, daher wird der Bestand live geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los dominios funcionan igual. Los gratuitos se agotan más a menudo, así que el stock se comprueba en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les domaines fonctionnent pareil. Les gratuits s'épuisent le plus souvent, le stock est donc vérifié en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dominio funziona allo stesso modo. Quelli gratuiti si esauriscono più spesso, quindi la disponibilità è verificata in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのドメインでも仕組みは同じです。無料のものは在庫切れになりやすいため、在庫はリアルタイムで確認しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer domínio funciona igual. Os grátis acabam com mais frequência, por isso o estoque é verificado em tempo real."
          }
        }
      }
    },
