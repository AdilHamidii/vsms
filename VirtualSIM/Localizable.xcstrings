    },
    "This number keeps running and still refunds itself if no code arrives.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nummer läuft weiter und wird weiterhin erstattet, wenn kein Code ankommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número sigue activo y se reembolsa igualmente si no llega ningún código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce numéro reste actif et sera quand même remboursé si aucun code n'arrive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo numero resta attivo e viene comunque rimborsato se non arriva alcun codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この番号は有効なままで、コードが届かなければ返金されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este número continua ativo e ainda é reembolsado se nenhum código chegar."
          }
        }
      }
    },
