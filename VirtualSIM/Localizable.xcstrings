        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crédits n'expirent jamais. SMS non reçu : remboursement automatique sous 2 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I crediti non scadono mai. SMS non riuscito: rimborso automatico entro 2 minuti."
