    "Totals include the %lld credits you already have. %@ in %@ costs %lld credits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Summen sind Ihre bereits vorhandenen %lld Credits enthalten. %@ in %@ kostet %lld Credits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Totals include the %1$lld credits you already have. %2$@ in %3$@ costs %4$lld credits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales incluyen los %lld créditos que ya tienes. %@ en %@ cuesta %lld créditos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux incluent les %lld crédits que vous avez déjà. %@ en %@ coûte %lld crédits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I totali includono i %lld crediti che hai già. %@ in %@ costa %lld crediti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計にはすでにお持ちの%1$lldクレジットが含まれます。%3$@の%2$@は%4$lldクレジットです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os totais incluem os %lld créditos que você já tem. %@ em %@ custa %lld créditos."
