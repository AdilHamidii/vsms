        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyo lo que dura una verificación, y luego desaparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vous le temps d'une vérification, puis il disparaît."
