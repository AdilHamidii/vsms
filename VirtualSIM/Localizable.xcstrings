    "Credits never expire. Failed SMS auto-refund within 2 minutes.": {
      "comment": "A footnote explaining that credits do not expire and that failed SMS auto-refunds occur within 2 minutes.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guthaben verfällt nie. Fehlgeschlagene SMS werden innerhalb von 2 Minuten automatisch erstattet."
