    "Rent a throwaway phone number, catch the verification SMS right here, and keep your real one off every signup form.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieten Sie eine Wegwerfnummer, empfangen Sie die Bestätigungs-SMS direkt hier – und halten Sie Ihre echte Nummer aus allen Anmeldeformularen heraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquila un número desechable, recibe el SMS de verificación aquí mismo y mantén tu número real fuera de todos los formularios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Louez un numéro jetable, recevez le SMS de vérification ici même — et gardez votre vrai numéro hors de tous les formulaires d'inscription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Noleggia un numero usa e getta, ricevi qui l'SMS di verifica e tieni il tuo numero vero lontano da ogni modulo di registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い捨て番号をレンタルして、認証SMSをこのアプリで受信。本当の電話番号をどの登録フォームにも渡さずに済みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alugue um número descartável, receba o SMS de verificação aqui mesmo e mantenha seu número real fora de todos os cadastros."
          }
        }
      }
    },
    "Reset map": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karte zurücksetzen"
