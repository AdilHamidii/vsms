    "That's the whole idea — you're here to keep your real number to yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genau darum geht es – Sie sind hier, um Ihre echte Nummer für sich zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa es la idea: estás aquí para no compartir tu número real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est tout l'intérêt — vous êtes ici pour garder votre vrai numéro pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
