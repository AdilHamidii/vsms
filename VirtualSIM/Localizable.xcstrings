    "Trying again isn't the same attempt: you'll get a different number, on a different carrier from the one that just failed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Versuch ist nicht derselbe Versuch: Sie erhalten eine andere Nummer, bei einem anderen Anbieter als dem, der gerade fehlgeschlagen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
