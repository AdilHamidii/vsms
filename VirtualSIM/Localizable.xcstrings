    "Get a private temporary number for verification codes on vSMS — my invite code %@ gives you 2 free credits: https://apps.apple.com/app/id6774768570": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir eine private temporäre Nummer für Bestätigungscodes mit vSMS. Mein Einladungscode %@ bringt dir 2 Gratis-Credits: https://apps.apple.com/app/id6774768570"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue un número temporal privado para códigos de verificación en vSMS. Mi código de invitación %@ te da 2 créditos gratis: https://apps.apple.com/app/id6774768570"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiens un numéro temporaire privé pour tes codes de vérification avec vSMS. Mon code d'invitation %@ t'offre 2 crédits gratuits : https://apps.apple.com/app/id6774768570"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni un numero temporaneo privato per i codici di verifica su vSMS. Il mio codice invito %@ ti dà 2 crediti gratis: https://apps.apple.com/app/id6774768570"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "vSMSで認証コード用のプライベートな一時番号を入手。招待コード %@ で無料クレジット2がもらえます: https://apps.apple.com/app/id6774768570"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consiga um número temporário privado para códigos de verificação no vSMS. Meu código de convite %@ dá 2 créditos grátis: https://apps.apple.com/app/id6774768570"
          }
        }
      }
    },
    "Get a private temporary number for verification codes on vSMS. Join with my code %@ and start with %lld free credits: https://apps.apple.com/app/id6774768570": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir eine private temporäre Nummer für Bestätigungscodes bei vSMS – tritt mit meinem Code %@ bei und starte mit %lld Gratis-Credits: https://apps.apple.com/app/id6774768570"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Get a private temporary number for verification codes on vSMS. Join with my code %1$@ and start with %2$lld free credits: https://apps.apple.com/app/id6774768570"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue un número temporal privado para códigos de verificación en vSMS: únete con mi código %@ y empieza con %lld créditos gratis: https://apps.apple.com/app/id6774768570"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez un numéro temporaire privé pour vos codes de vérification sur vSMS. Inscrivez-vous avec mon code %@ et démarrez avec %lld crédits offerts : https://apps.apple.com/app/id6774768570"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni un numero temporaneo privato per i codici di verifica su vSMS. Iscriviti con il mio codice %@ e inizia con %lld crediti gratis: https://apps.apple.com/app/id6774768570"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "vSMSで認証コード用のプライベートな一時番号を取得しましょう。私のコード%@で参加すると%lldクレジット無料で始められます: https://apps.apple.com/app/id6774768570"
