          "stringUnit": {
            "state": "translated",
            "value": "Kleinanzeigen. Dating-Apps. Ein Nebengeschäft. Der Käufer, der Ihnen wegen des Sofas schreiben will. Keiner davon braucht die Nummer, die Ihre Familie nutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncios de compraventa. Apps de citas. Un negocio paralelo. El comprador que quiere escribirte por el sofá. Ninguno necesita el número que usa tu familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petites annonces. Applis de rencontre. Une activité en parallèle. L'acheteur qui veut vous écrire pour le canapé. Aucun n'a besoin du numéro que votre famille utilise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annunci di compravendita. App di incontri. Un'attività secondaria. Chi vuole scriverti per il divano. Nessuno di loro ha bisogno del numero che usa la tua famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フリマの出品。マッチングアプリ。副業。ソファについて連絡してくる買い手。どれも家族が使う番号である必要はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anúncios de compra e venda. Apps de namoro. Um negócio paralelo. O comprador que quer falar sobre o sofá. Nenhum deles precisa do número que sua família usa."
          }
        }
      }
    },
    "Marketplace listings. Dating apps. A side business. The contractor who needs a number to call back on. None of them need the one your family uses.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinanzeigen. Dating-Apps. Ein Nebengewerbe. Der Handwerker, der eine Rückrufnummer braucht. Keiner davon braucht die, die Ihre Familie nutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuncios de segunda mano. Apps de citas. Un negocio paralelo. El técnico que necesita un número al que devolver la llamada. Ninguno necesita el que usa tu familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des petites annonces. Des applis de rencontre. Une activité secondaire. L'artisan qui a besoin d'un numéro pour vous rappeler. Aucun n'a besoin de celui que votre famille utilise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annunci sui marketplace. App di incontri. Un'attività secondaria. L'artigiano che ha bisogno di un numero per richiamarti. Nessuno di loro ha bisogno di quello che usa la tua famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フリマの出品。マッチングアプリ。副業。折り返しの連絡先が必要な業者。どれも、家族が使っている番号を教える必要はありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anúncios em marketplace. Apps de namoro. Um negócio paralelo. O prestador de serviço que precisa de um número para retornar. Nenhum deles precisa daquele que sua família usa."
          }
        }
      }
    },
