    "Your subscription is active but no number was assigned. We've been alerted and will sort this out. Please don't subscribe again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Abo ist aktiv, aber es wurde keine Nummer zugewiesen. Wir wurden benachrichtigt und kümmern uns darum – bitte abonnieren Sie nicht erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción está activa pero no se asignó ningún número. Ya nos han avisado y lo resolveremos: no te vuelvas a suscribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement est actif mais aucun numéro n'a été attribué. Nous avons été alertés et allons régler cela. Ne vous réabonnez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è attivo ma non è stato assegnato alcun numero. Siamo stati avvisati e risolveremo. Per favore non abbonarti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは有効ですが、番号が割り当てられていません。こちらで検知しており対応します。再度登録しないでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura está ativa, mas nenhum número foi atribuído. Já fomos avisados e vamos resolver. Por favor, não assine de novo."
          }
        }
      }
    },
    "Your subscription lapsed. You can still receive texts and calls, but you can't send until you renew.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Abo ist abgelaufen. Sie können weiterhin SMS und Anrufe empfangen, aber erst nach einer Verlängerung wieder senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción ha caducado. Sigues pudiendo recibir mensajes y llamadas, pero no puedes enviar hasta que la renueves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a expiré. Vous pouvez encore recevoir des SMS et des appels, mais vous ne pourrez pas en envoyer avant de le renouveler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è scaduto. Puoi ancora ricevere SMS e chiamate, ma non puoi inviare finché non rinnovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションが失効しました。SMSと通話の受信はできますが、更新するまで送信はできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura expirou. Você ainda recebe mensagens e chamadas, mas não pode enviar até renovar."
          }
        }
      }
    },
    "Your subscription lapsed. You can still receive texts, but you can't send until you renew.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Abo ist abgelaufen. Sie können weiterhin SMS empfangen, aber erst nach der Verlängerung wieder senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción ha caducado. Aún puedes recibir mensajes, pero no podrás enviar hasta que la renueves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a expiré. Vous pouvez toujours recevoir des SMS, mais pas en envoyer avant de le renouveler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è scaduto. Puoi ancora ricevere SMS, ma non puoi inviarne finché non lo rinnovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションが失効しました。SMSの受信は引き続き可能ですが、更新するまで送信はできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura expirou. Você ainda pode receber SMS, mas não poderá enviar até renovar."
          }
        }
      }
    },
    "Your subscription went through but we couldn't set the number up. Contact support, and don't buy again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Abo ging durch, aber wir konnten die Nummer nicht einrichten. Kontaktieren Sie den Support – kaufen Sie nicht erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción se completó pero no pudimos configurar el número. Contacta con soporte: no vuelvas a comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement a été validé mais nous n'avons pas pu configurer le numéro. Contactez l'assistance, et n'achetez pas à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento è andato a buon fine ma non siamo riusciti a configurare il numero. Contatta l'assistenza, e non acquistare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは完了しましたが、番号を設定できませんでした。サポートにご連絡ください。再度購入しないでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura foi concluída, mas não conseguimos configurar o número. Fale com o suporte, e não compre de novo."
          }
        }
      }
    },
    "Your subscription went through but we couldn't set the number up. It'll retry automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Abo ging durch, aber wir konnten die Nummer nicht einrichten. Es wird automatisch erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción se completó pero no pudimos configurar el número. Se reintentará automáticamente."
