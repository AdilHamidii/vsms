      }
    },
    "Totals include the %lld credits you already have. A typical number costs %lld credits. Prices vary by service and country.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Summen sind Ihre bereits vorhandenen %lld Credits enthalten. Eine typische Nummer kostet %lld Credits – die Preise variieren je nach Dienst und Land."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Totals include the %1$lld credits you already have. A typical number costs %2$lld credits. Prices vary by service and country."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales incluyen los %lld créditos que ya tienes. Un número normal cuesta %lld créditos; los precios varían según el servicio y el país."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux incluent les %lld crédits que vous avez déjà. Un numéro coûte en général %lld crédits. Les prix varient selon le service et le pays."
