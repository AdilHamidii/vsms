    "%@ often rejects standard numbers. We recommend Real SIM.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lehnt Standardnummern häufig ab. Wir empfehlen Echte SIM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ suele rechazar los números estándar. Recomendamos SIM real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ refuse souvent les numéros standard. Nous recommandons la SIM réelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rifiuta spesso i numeri standard. Consigliamo SIM reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は標準番号を拒否することがよくあります。実SIMをおすすめします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ costuma recusar números padrão. Recomendamos SIM real."
          }
        }
      }
    },
    "%@ ranks highest for %@ network-wide: %lld%% in the last 24h. We haven't tested it ourselves yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liegt für %2$@ netzwerkweit vorn – %3$lld %% in den letzten 24 Std. Wir haben es selbst noch nicht getestet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ranks highest for %2$@ network-wide: %3$lld%% in the last 24h. We haven't tested it ourselves yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es el mejor para %2$@ en toda la red: un %3$lld %% en las últimas 24 h. Aún no lo hemos probado nosotros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ arrive en tête pour %2$@ à l’échelle du réseau : %3$lld %% sur les dernières 24 h. Nous ne l’avons pas encore testé nous-mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è il migliore per %2$@ sull’intera rete: %3$lld%% nelle ultime 24 h. Non l’abbiamo ancora testato di persona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ではネットワーク全体で %1$@ が最上位で、過去24時間で %3$lld%% です。当社ではまだ検証していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lidera para %2$@ em toda a rede: %3$lld%% nas últimas 24 h. Ainda não testamos por conta própria."
          }
        }
      }
    },
