    "One tap with Apple next. No password to make, no email list, and your real number never comes into it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes ein Tipp mit Apple – kein Passwort anlegen, kein Newsletter, und Ihre echte Nummer bleibt außen vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora un toque con Apple: sin contraseñas que crear, sin listas de correo y sin tu número real de por medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, une touche avec Apple. Aucun mot de passe à créer, aucune liste d'e-mails, et votre vrai numéro n'entre jamais en jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi un tocco con Apple. Nessuna password da creare, nessuna mailing list e il tuo numero vero non entra mai in gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次は「Appleでサインイン」をタップするだけ。パスワードの作成もメール配信もなく、本当の電話番号を使うこともありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque com a Apple a seguir. Sem criar senha, sem lista de e-mails, e seu número real nunca entra nisso."
          }
        }
      }
    },
