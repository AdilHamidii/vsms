    "Travel eSIMs are temporarily off sale. Any eSIM you already bought keeps working. Find it under My eSIMs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reise-eSIMs sind vorübergehend nicht im Verkauf. Bereits gekaufte eSIMs funktionieren weiterhin – du findest sie unter „Meine eSIMs“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las eSIM de viaje no están a la venta temporalmente. Cualquier eSIM que ya hayas comprado sigue funcionando: la encontrarás en «Mis eSIM»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les eSIM de voyage sont temporairement retirées de la vente. Toute eSIM déjà achetée continue de fonctionner. Retrouvez-la dans « Mes eSIM »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le eSIM da viaggio non sono temporaneamente in vendita. Le eSIM già acquistate continuano a funzionare: le trovi in «Le mie eSIM»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラベルeSIMは一時的に販売を停止しています。購入済みのeSIMは引き続きご利用いただけます。「マイeSIM」からご確認ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As eSIMs de viagem estão temporariamente fora de venda. Qualquer eSIM que você já comprou continua funcionando. Encontre-a em «Meus eSIMs»."
          }
        }
      }
    },
