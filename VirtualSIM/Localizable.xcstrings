    "We haven't ordered %@ anywhere that matches yet. Untested countries are still buyable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben %@ noch nirgends passend bestellt. Ungetestete Länder sind trotzdem buchbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hemos pedido %@ en ningún sitio que coincida. Los países sin probar se pueden comprar igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
