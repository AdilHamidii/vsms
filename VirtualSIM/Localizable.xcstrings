    "%@ often rejects standard numbers. We recommend Real SIM.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lehnt Standardnummern häufig ab. Wir empfehlen Echte SIM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ suele rechazar los números estándar. Recomendamos SIM real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ refuse souvent les numéros standard. Nous recommandons la SIM réelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rifiuta spesso i numeri standard. Consigliamo SIM reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は標準番号を拒否することがよくあります。実SIMをおすすめします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ costuma recusar números padrão. Recomendamos SIM real."
          }
        }
      }
    },
    "%@ rejects internet numbers, so only Real SIM works here.": {
      "extractionState": "manual",
      "localizations": {
