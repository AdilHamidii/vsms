    "It is not our own delivery record. Where we have ordered here ourselves, the row says so separately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist nicht unsere eigene Zustellrate. Wo wir hier selbst bestellt haben, steht das separat in der Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es nuestro propio registro de entrega. Cuando hemos pedido aquí nosotros mismos, la fila lo indica por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas notre propre taux de livraison. Là où nous avons commandé nous-mêmes, la ligne l'indique séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è il nostro dato di consegna. Dove abbiamo ordinato noi stessi, la riga lo indica separatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当社自身の配信実績ではありません。当社が実際に注文したことがある場合は、その行に別途表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é o nosso próprio histórico de entrega. Onde já pedimos por conta própria, a linha indica isso separadamente."
          }
        }
      }
    },
