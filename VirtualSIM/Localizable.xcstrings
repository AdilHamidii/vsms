    "A real person reads these. If we're asleep you'll get a reply as soon as we're up — you'll be notified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein echter Mensch liest mit. Wenn wir schlafen, antworten wir, sobald wir wach sind – Sie werden benachrichtigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona real lee esto. Si estamos durmiendo, responderemos en cuanto despertemos: le avisaremos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vraie personne vous lit. Si nous dormons, vous aurez une réponse dès notre réveil — vous serez notifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona vera legge questi messaggi. Se dormiamo, risponderemo appena svegli: riceverà una notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の担当者が確認します。就寝中の場合は起き次第返信し、通知が届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa real lê isto. Se estivermos dormindo, responderemos assim que acordarmos — você será notificado."
          }
        }
      }
    },
