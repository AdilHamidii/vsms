    "Renews every month until you cancel. Cancel any time in your Apple ID settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich monatlich, bis Sie kündigen. Jederzeit in Ihren Apple-ID-Einstellungen kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada mes hasta que canceles. Cancela cuando quieras en los ajustes de tu Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle chaque mois jusqu'à annulation. Annulez à tout moment dans les réglages de votre identifiant Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova ogni mese finché non disdici. Disdici quando vuoi nelle impostazioni del tuo ID Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルするまで毎月自動更新されます。Apple IDの設定からいつでもキャンセルできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova todo mês até você cancelar. Cancele quando quiser nos ajustes do seu ID Apple."
          }
        }
      }
    },
    "Rent a throwaway phone number, catch the verification SMS right here, and keep your real one off every signup form.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieten Sie eine Wegwerfnummer, empfangen Sie die Bestätigungs-SMS direkt hier – und halten Sie Ihre echte Nummer aus allen Anmeldeformularen heraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alquila un número desechable, recibe el SMS de verificación aquí mismo y mantén tu número real fuera de todos los formularios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Louez un numéro jetable, recevez le SMS de vérification ici même, et gardez votre vrai numéro hors de tous les formulaires d'inscription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Noleggia un numero usa e getta, ricevi qui l'SMS di verifica e tieni il tuo numero vero lontano da ogni modulo di registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い捨て番号をレンタルして、認証SMSをこのアプリで受信。本当の電話番号をどの登録フォームにも渡さずに済みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alugue um número descartável, receba o SMS de verificação aqui mesmo e mantenha seu número real fora de todos os cadastros."
          }
        }
      }
    },
