    "Texts sent to it land here. Share it with someone to get started.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An sie gesendete SMS landen hier. Teilen Sie sie mit jemandem, um loszulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes que le envíen aparecen aquí. Compártelo con alguien para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les SMS qui lui sont envoyés arrivent ici. Partagez-le avec quelqu'un pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli SMS inviati a questo numero arrivano qui. Condividilo con qualcuno per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この番号宛のSMSはここに表示されます。誰かに番号を教えて始めましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens enviadas para ele aparecem aqui. Compartilhe com alguém para começar."
          }
        }
      }
    },
    "That code isn't valid.": {
