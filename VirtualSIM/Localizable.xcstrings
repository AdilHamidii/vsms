    "We're sorry for the hassle. We're actively working on improving delivery rates.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir bitten um Entschuldigung für die Unannehmlichkeiten. Wir arbeiten aktiv daran, die Zustellraten zu verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentimos las molestias. Estamos trabajando activamente para mejorar las tasas de entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolés pour la gêne occasionnée. Nous travaillons activement à améliorer les taux de réception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci scusiamo per il disagio. Stiamo lavorando attivamente per migliorare i tassi di consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご不便をおかけして申し訳ありません。到達率の改善に取り組んでいます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedimos desculpas pelo transtorno. Estamos trabalhando ativamente para melhorar as taxas de entrega."
          }
        }
      }
    },
    "We're updating live prices across all providers. Ordering is paused for a few minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir aktualisieren gerade die Live-Preise aller Anbieter. Bestellungen sind für einige Minuten pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos actualizando los precios en vivo de todos los proveedores. Los pedidos están en pausa unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous mettons à jour les prix en direct de tous les fournisseurs. Les commandes sont suspendues quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo aggiornando i prezzi live di tutti i provider. Gli ordini sono in pausa per qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全プロバイダーの最新価格を更新中です。注文は数分間停止しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos atualizando os preços de todos os provedores. Os pedidos estão pausados por alguns minutos."
          }
        }
      }
    },
